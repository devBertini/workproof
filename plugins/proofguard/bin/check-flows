#!/bin/sh
# check-flows: runs scripts/check_flows.py (the flow-map engine) with the first working Python 3 (skips the Windows Store stub).
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
script="$dir/../scripts/check_flows.py"
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "" >/dev/null 2>&1; then
    exec "$py" -B "$script" "$@"
  fi
done
if command -v py >/dev/null 2>&1 && py -3 -c "" >/dev/null 2>&1; then
  exec py -3 -B "$script" "$@"
fi
echo "check-flows: no working Python 3 found (tried python3, python, py -3)" >&2
exit 1
